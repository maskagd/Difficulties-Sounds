{
	"geode": "5.0.0-beta.3",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "maskagd.difficulties_sounds",
	"name": "Difficulties Sounds",
	"version": "v1.0.3",
	"developer": "maskagd",
	"description": "adds custom SFX on difficulties buttons",
	"tags": ["customization", "offline", "enhancement", "joke"],
	"resources": {
		"files": [
            "res/audio/jg/*.ogg",
			"res/audio/niko/*.ogg"
		]
	},
	"dependencies": {
		"geode.node-ids": ">=v1.20.0"
	},
	"links": {
        "source": "https://github.com/maskagd/difficulties-sounds",
        "homepage": "https://www.youtube.com/@maskagd"
    },
	"settings": {
		"standart-title": {
			"type": "title",
			"name": "Sounds settings"
		},
		"sound-enable": {
			"type": "bool",
			"name": "Enable sounds",
			"default": true
		},
		"sound-volume": {
			"type": "int",
			"name": "sound volume",
			"default": 50,
			"min": 0,
			"max": 200,
			"enable-if": "sound-enable"
		},
		"sound-type": {
			"type": "string",
			"name": "Sound Type",
			"default": "jigglegiggle11",
   "enable-if": "sound-enable",
			"one-of": ["jigglegiggle11", "nnikzuu"]
		},
		"custom-title": {
			"type": "title",
			"name": "Custom sounds settings"
		},
		"sound-custom": {
			"type": "bool",
			"name": "Use custom sounds",
			"default": false
			"enable-if": "sound-enable"
		},
		"na-sound": {
	"type": "file",
	"name": "Custom NA sound",
	"default": "audio file",
	"enable-if": "sound-enable && sound-custom",
	"control": {
		"dialog": "open",
		"filters": [
			{
				"files": ["*.wav", "*.ogg", "*.mp3", "*.flac"]
			}
		]
	}
},
